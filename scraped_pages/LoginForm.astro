---
let error = '';
---
<form id="login-form" accept-charset="UTF-8">
    <div>
        <label for="name">Name:</label>
        <br />
        <input name="name" type="text" required />
    </div>
    <div>
        <label for="email">Email:</label>
        <br />
        <input name="email" type="email" required />
    </div>
    <br />
    <button type="submit">Login</button>
    <button type="submit" id="check-auth">Check auth</button>
    <p id="error-msg">{error}</p>
</form>

<script type="module">
    document.querySelector('#login-form').addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(e.target);
        const body = {
            name: formData.get('name'),
            email: formData.get('email'),
        };

        const response = await fetch('https://frontend-take-home-service.fetch.com/auth/login', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            credentials: 'include',
            body: JSON.stringify(body),
        });

        const text = await response.text();
        console.log('Text response:', text);
        console.log('Response:', response);

        if (response.ok) {
            console.log('Login successful!');
            // window.location.href = '/';
        } else {
            document.querySelector('#error-msg').textContent = result.error || 'Login failed';
        }
    })
    document.querySelector('#check-auth').addEventListener('click', async (e) => {
        e.preventDefault();

        const response = await fetch('https://frontend-take-home-service.fetch.com/dogs/breeds', {
            method: 'GET',
            credentials: 'include',
        });

        if (response.ok) {
            console.log('USER IS LOGGED IN.');
        } else {
            console.log('USER IS NOT AUTHENTICATED.');
        }
        console.log(response);
    });
</script>