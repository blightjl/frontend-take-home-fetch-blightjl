---
const { title } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
</head>
<body>
    <nav class="main-nav">
        <a href="/" data-astro-prefetch>Home</a>
        <a href="/dashboard" data-astro-prefetch class="auth-only" style="display: none;">Dashboard</a>
        <a href="/login" data-astro-prefetch class="no-auth-only" style="display: none;">Login</a>
        <button class="logout-btn auth-only" style="display: none;">Logout</button>
    </nav>
    <main>
        <slot />
    </main>
    <footer>
        <p>&copy; 2025 Your Application</p>
    </footer>
    <script>
        function updateNavigation() {
            const isAuthenticated = localStorage.getItem('isAuthenticated') === 'true';
            const authOnlyElements = document.querySelectorAll('.auth-only');
            const noAuthOnlyElements = document.querySelectorAll('.no-auth-only');

            authOnlyElements.forEach(el => {
                (el as HTMLElement).style.display = isAuthenticated ? 'inline-block' : 'none';
            });

            noAuthOnlyElements.forEach(el => {
                (el as HTMLElement).style.display = isAuthenticated ? 'none' : 'inline-block';
            });
        }

        // adding the logout handler
        document.querySelector('.logout-btn')?.addEventListener('click', async () => {
            try {
                const response = await fetch('https://frontend-take-home-service.fetch.com/auth/logout', {
                method: 'POST',
                // headers: { 'Content-Type': 'application/json' },
                credentials: 'include'
            });

                if (response.ok) {
                    localStorage.removeItem('isAuthenticated');
                    localStorage.removeItem('isFirstDashboardBisit');
                    window.location.href = '/';
                }
            } catch (error) {
                console.error('Logout failed:', error);
            }
        })

        // on page load
        updateNavigation();

        // rerun if storage chagnes (when another tab logs in / out)
        window.addEventListener('storage', updateNavigation);
    </script>
</body>
</html>